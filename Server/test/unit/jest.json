{
    "testTimeout": 10000,
    "rootDir": "../../",
    "setupFiles": [
        "<rootDir>/test/unit/jest.setup.js"
    ],
    "modulePaths": [
        "."
    ],
    "testEnvironment": "node",
    "testMatch": [
        "<rootDir>/test/unit/auth/**/*.spec.ts",
        "<rootDir>/test/unit/crm/**/*.spec.ts",
        "<rootDir>/test/unit/workspace/**/*.spec.ts",
        "<rootDir>/test/unit/contact/**/*.spec.ts",
        "<rootDir>/test/unit/instagram/**/*.spec.ts",
        "<rootDir>/test/unit/messaging/**/*.spec.ts",
        "<rootDir>/test/unit/automation/**/*.spec.ts",
        "<rootDir>/test/unit/flow-builder/**/*.spec.ts",
        "<rootDir>/test/unit/ai/**/*.spec.ts",
        "<rootDir>/test/unit/billing/**/*.spec.ts",
        "<rootDir>/test/unit/webhook/**/*.spec.ts",
        "<rootDir>/test/unit/marketplace/**/*.spec.ts",
        "<rootDir>/test/unit/campaign/**/*.spec.ts",
        "<rootDir>/test/unit/forms/**/*.spec.ts",
        "<rootDir>/test/unit/dashboard/**/*.spec.ts"
    ],
    "collectCoverage": false,
    "moduleFileExtensions": [
        "js", 
        "ts", 
        "json"
    ],
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    }
}
